# Copy to .env.local (ignored) or export in your shell. The browser never sees these.
# Claude: either a direct Anthropic key...
ANTHROPIC_API_KEY=
# ...or Snowflake Cortex AI Gateway (Anthropic-compatible Messages API, bearer PAT):
# ANTHROPIC_BASE_URL=<your account's Cortex AI Gateway endpoint; see the Cortex AI Gateway docs>
# CORTEX_GATEWAY_PAT=
OPEN_LOOPS_MODEL=claude-sonnet-5-5

# Snowflake SQL API v2 (leave empty to use data/demo-evidence.json, labeled "Demo data" in the UI)
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_PAT=
SNOWFLAKE_DATABASE=OPEN_LOOPS
SNOWFLAKE_SCHEMA=PUBLIC
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
# SNOWFLAKE_ROLE=ACCOUNTADMIN
OPEN_LOOPS_OWNER=Alex Rivera
