{
  "name": "open-loops-preview",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Open Loops: a desktop companion that turns stale work in Snowflake into cited Claude decision cards",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "format": "prettier --write . --ignore-unknown",
    "format:check": "prettier --check . --ignore-unknown",
    "lint": "npm run lint:code && npm run lint:docs",
    "lint:code": "eslint . && html-validate 'previews/*.html' && stylelint 'previews/assets/*.css' --allow-empty-input",
    "lint:docs": "markdownlint-cli2 '**/*.md'",
    "test": "node --test scripts/*.test.mjs",
    "test:ui": "playwright test",
    "check:sentrux": "node scripts/sentrux-check.mjs",
    "bundle": "node scripts/bundle.mjs",
    "live": "node server/server.mjs",
    "demo:record": "node ~/.claude/skills/record-demo/bin/record.mjs demos/live-flow.mjs --out docs/media"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "html-validate": "11.17.0",
    "markdownlint-cli2": "0.24.0",
    "prettier": "3.9.10",
    "stylelint": "17.16.0",
    "yaml": "2.9.1"
  },
  "license": "GPL-3.0-or-later"
}
